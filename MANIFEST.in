include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
recursive-include docs *.md *.png
recursive-include src *.py py.typed
recursive-include tests *.py
prune dist
prune src/silver_torch.egg-info
prune .git
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune __pycache__
global-exclude *.py[cod]
